---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import { projects } from "../../data/projects";

const featuredProjects = projects.filter(
  (project) => project.featured
);

const additionalProjects = projects.filter(
  (project) => !project.featured
);
---

<BaseLayout
  title="Projects | Daniela Chanta"
  description="Data Science, Machine Learning, AI and engineering projects by Daniela Chanta."
>

  <Navbar />

  <main>

    <!-- HEADER -->

    <section
      class="mx-auto max-w-6xl px-6 pb-20 pt-40 lg:px-8"
    >

      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
      >
        Projects
      </p>

      <h1
        class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"
      >
        Selected work across data science, machine learning and engineering.
      </h1>

      <p
        class="mt-7 max-w-2xl text-lg leading-8 text-slate-600"
      >
        A collection of professional, research and academic projects
        spanning applied AI, machine learning, NLP, computer vision,
        IoT and data-driven engineering.
      </p>

    </section>


    <!-- FEATURED -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-20 lg:px-8"
    >

      <p
        class="mb-10 text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
      >
        Featured Projects
      </p>

      <div class="grid gap-6 md:grid-cols-2">

        {
          featuredProjects.map((project) => (
            <ProjectCard {...project} />
          ))
        }

      </div>

    </section>


    <!-- ADDITIONAL -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-20 lg:px-8"
    >

      <div class="mb-10">

        <p
          class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
        >
          Additional Projects
        </p>

        <h2
          class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
        >
          Machine learning & research.
        </h2>

      </div>


      <div class="grid gap-6 md:grid-cols-2">

        {
          additionalProjects.map((project) => (
            <ProjectCard {...project} />
          ))
        }

      </div>

    </section>

  </main>

  <Footer />

</BaseLayout>