---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectHero from "../../components/ProjectHero.astro";

const technologies = [
  "Python",
  "FastAPI",
  "OpenAI API",
  "Microsoft Azure",
  "Zoho Creator",
  "Zoho Cliq",
  "Deluge",
  "REST APIs",
];
---

<BaseLayout
  title="AI-Powered Business Automation | Daniela Chanta"
  description="AI-powered business automation system integrating OpenAI, FastAPI, Azure and Zoho workflows."
>
  <Navbar />

  <main>

    <!-- PROJECT HERO -->

    <ProjectHero
      category="AI Engineering · Business Automation"
      title="AI-Powered Business Automation"
      description="A conversational AI and automation system designed to connect natural-language requests with internal business workflows across Zoho Creator and Zoho Cliq."
      year="2026"
      role="AI Automation Consultant"
      organization="ALSI Perú"
      technologies={technologies}
    />


    <!-- OVERVIEW -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >
      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>
          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Overview
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Connecting conversational AI with real business processes.
          </h2>
        </div>

        <div class="space-y-6 text-base leading-8 text-slate-600">

          <p>
            The project focused on integrating AI-powered interaction into
            internal applications used by ALSI Perú. The goal was not to
            replace existing business systems, but to create a more natural
            interface between users and structured workflows already managed
            through Zoho Creator.
          </p>

          <p>
            A Python and FastAPI backend connected Zoho services with the
            OpenAI API. Natural-language requests could be interpreted,
            converted into structured actions and validated before interacting
            with internal business applications.
          </p>

          <p>
            Two main use cases were developed: a conversational workflow for
            Commercial app and automation features for the Rendiciones app
            expense-management application.
          </p>

        </div>

      </div>
    </section>


    <!-- PROBLEM -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >
      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>
          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            The Problem
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Business workflows were structured, but interaction remained manual.
          </h2>
        </div>

        <div class="space-y-6 text-base leading-8 text-slate-600">

          <p>
            Internal applications already contained the logic required to
            register and manage business information. However, users still had
            to interact directly with forms and application-specific interfaces
            to execute many routine tasks.
          </p>

          <p>
            The project explored how natural-language interaction could be
            added on top of these systems while preserving validation,
            permissions and deterministic execution of business actions.
          </p>

        </div>

      </div>
    </section>


    <!-- ARCHITECTURE -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="max-w-3xl">

        <p
          class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
        >
          Architecture
        </p>

        <h2
          class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
        >
          From natural language to controlled execution.
        </h2>

        <p class="mt-6 leading-8 text-slate-600">
          The conversational layer interprets the user's request, while
          deterministic application logic remains responsible for validation
          and execution.
        </p>

      </div>


      <div
        class="mt-14 grid items-center gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr]"
      >

        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
            01
          </p>

          <h3 class="mt-3 font-semibold text-slate-950">
            User
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Sends a request using natural language.
          </p>
        </div>

        <div class="hidden text-slate-300 lg:block">
          →
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
            02
          </p>

          <h3 class="mt-3 font-semibold text-slate-950">
            Zoho Cliq
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Provides the conversational interface.
          </p>
        </div>

        <div class="hidden text-slate-300 lg:block">
          →
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
            03
          </p>

          <h3 class="mt-3 font-semibold text-slate-950">
            FastAPI + OpenAI
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Interprets intent and generates structured information.
          </p>
        </div>

        <div class="hidden text-slate-300 lg:block">
          →
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
            04
          </p>

          <h3 class="mt-3 font-semibold text-slate-950">
            Zoho Creator
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Executes validated business operations through APIs.
          </p>
        </div>

      </div>

    </section>


    <!-- COMMERCIAL -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>
          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Use Case 01
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Commercial
          </h2>
        </div>


        <div>

          <h3 class="text-xl font-semibold text-slate-950">
            Conversational lead-source creation
          </h3>

          <p class="mt-5 leading-8 text-slate-600">
            A conversational assistant was implemented in Zoho Cliq,
            allowing users to create a commercial source and assign it to an
            employee through natural-language commands.
          </p>

          <p class="mt-5 leading-8 text-slate-600">
            Instead of directly executing the action after interpreting a
            request, the assistant generated a confirmation step. The user
            could review the interpreted information and explicitly approve or
            cancel the operation.
          </p>


          <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-8">

            <p
              class="text-xs font-medium uppercase tracking-[0.15em] text-slate-400"
            >
              Example workflow
            </p>

            <div class="mt-7 space-y-5">

              <div class="flex gap-4">

                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-950 text-xs text-white"
                >
                  1
                </span>

                <p class="text-sm leading-7 text-slate-600">
                  User requests the creation of a commercial source using
                  natural language.
                </p>

              </div>


              <div class="flex gap-4">

                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-950 text-xs text-white"
                >
                  2
                </span>

                <p class="text-sm leading-7 text-slate-600">
                  The system identifies the intended action and extracts the
                  required information.
                </p>

              </div>


              <div class="flex gap-4">

                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-950 text-xs text-white"
                >
                  3
                </span>

                <p class="text-sm leading-7 text-slate-600">
                  A confirmation message is displayed before any modification
                  is performed.
                </p>

              </div>


              <div class="flex gap-4">

                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-950 text-xs text-white"
                >
                  4
                </span>

                <p class="text-sm leading-7 text-slate-600">
                  After confirmation, the application executes the operation
                  through the Zoho Creator API.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- RENDICIONES -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>
          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Use Case 02
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Rendiciones
          </h2>
        </div>


        <div>

          <h3 class="text-xl font-semibold text-slate-950">
            AI-assisted expense validation
          </h3>

          <p class="mt-5 leading-8 text-slate-600">
            The second use case focused on supporting the expense-management
            workflow. The system processed supporting evidence associated with
            expense submissions and generated structured information that
            could be consumed by the existing Zoho Creator application.
          </p>

          <p class="mt-5 leading-8 text-slate-600">
            The implementation included evidence validation, image and
            screenshot analysis, and generation of structured JSON responses
            used by the application logic.
          </p>

        </div>

      </div>

    </section>


    <!-- AI VS AUTOMATION -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="max-w-3xl">

        <p
          class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
        >
          System Design
        </p>

        <h2
          class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
        >
          AI where interpretation was needed. Automation where reliability mattered.
        </h2>

        <p class="mt-6 leading-8 text-slate-600">
          A central design decision was to separate probabilistic AI tasks from
          deterministic business logic.
        </p>

      </div>


      <div class="mt-12 grid gap-6 md:grid-cols-2">

        <!-- AI -->

        <article class="rounded-2xl border border-slate-200 bg-white p-8">

          <p
            class="text-xs font-medium uppercase tracking-[0.15em] text-slate-400"
          >
            AI Layer
          </p>

          <h3 class="mt-4 text-xl font-semibold text-slate-950">
            Interpretation
          </h3>

          <ul class="mt-6 space-y-4 text-sm leading-7 text-slate-600">

            <li>
              Natural-language intent interpretation
            </li>

            <li>
              Extraction of structured information
            </li>

            <li>
              Analysis of supporting images and screenshots
            </li>

            <li>
              Generation of structured JSON responses
            </li>

          </ul>

        </article>


        <!-- AUTOMATION -->

        <article class="rounded-2xl border border-slate-200 bg-white p-8">

          <p
            class="text-xs font-medium uppercase tracking-[0.15em] text-slate-400"
          >
            Automation Layer
          </p>

          <h3 class="mt-4 text-xl font-semibold text-slate-950">
            Execution
          </h3>

          <ul class="mt-6 space-y-4 text-sm leading-7 text-slate-600">

            <li>
              User confirmation before execution
            </li>

            <li>
              API calls to Zoho Creator
            </li>

            <li>
              Business-rule validation
            </li>

            <li>
              Controlled modification of application records
            </li>

          </ul>

        </article>

      </div>

    </section>


    <!-- TECH STACK -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>
          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Technology
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Technical stack
          </h2>
        </div>


        <div class="grid gap-8 sm:grid-cols-2">

          <div>
            <p class="text-sm font-semibold text-slate-950">
              Backend
            </p>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Python · FastAPI
            </p>
          </div>


          <div>
            <p class="text-sm font-semibold text-slate-950">
              AI
            </p>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              OpenAI API · Structured outputs
            </p>
          </div>


          <div>
            <p class="text-sm font-semibold text-slate-950">
              Business Applications
            </p>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Zoho Creator · Zoho Cliq · Deluge
            </p>
          </div>


          <div>
            <p class="text-sm font-semibold text-slate-950">
              Infrastructure
            </p>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Microsoft Azure · REST APIs
            </p>
          </div>

        </div>

      </div>

    </section>


    


    <!-- NEXT PROJECT -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-20 lg:px-8"
    >
      <div
        class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
      >

        <div>
          <p
            class="text-sm uppercase tracking-[0.18em] text-slate-400"
          >
            Next Project
          </p>

          <h2
            class="mt-3 text-2xl font-semibold text-slate-950"
          >
            Detecting Speculative Dynamics in AI Stocks
          </h2>
        </div>

        <a
          href="/projects/ai-stocks"
          class="text-sm font-medium text-slate-900"
        >
          View project →
        </a>

      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>