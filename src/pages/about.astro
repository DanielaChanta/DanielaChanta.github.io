---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="About | Daniela Chanta"
  description="About Daniela Chanta: electronic engineer, Data Science student at École Polytechnique and engineering student at Télécom Paris."
>
  <Navbar />

  <main>

    <!-- HEADER -->

    <section
      class="mx-auto max-w-6xl px-6 pb-20 pt-40 lg:px-8"
    >

      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
      >
        About
      </p>

      <div class="mt-5 grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">

        <div>

          <h1
            class="max-w-4xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"
          >
            From electronic engineering to data science and applied AI.
          </h1>

          <div
            class="mt-8 max-w-3xl space-y-6 text-lg leading-8 text-slate-600"
          >

            <p>
              I am an electronic engineer from Peru currently pursuing an M2
              in Data Science at École Polytechnique and a double engineering
              degree at Télécom Paris.
            </p>

            <p>
              My path into data science grew from working with signals,
              sensors, computer vision and IoT systems. Over time, my work
              evolved toward machine learning, statistical modeling, data
              systems and AI-powered applications.
            </p>

            <p>
              I am particularly interested in problems where data and machine
              learning interact with real systems: from NLP and AI engineering
              to streaming data, industrial applications and decision-support
              tools.
            </p>

          </div>

        </div>


        <!-- QUICK INFO -->

        <aside
          class="h-fit rounded-2xl border border-slate-200 bg-white p-8"
        >

          <p
            class="text-xs font-medium uppercase tracking-[0.15em] text-slate-400"
          >
            Currently
          </p>

          <div class="mt-6 space-y-6">

            <div>

              <p class="text-sm font-semibold text-slate-950">
                M2 Data Science
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                École Polytechnique · Institut Polytechnique de Paris
              </p>

            </div>


            <div>

              <p class="text-sm font-semibold text-slate-950">
                Diplôme d'Ingénieur
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Télécom Paris · Double Degree
              </p>

            </div>


            <div>

              <p class="text-sm font-semibold text-slate-950">
                Based in
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Île-de-France, France
              </p>

            </div>


            <div>

              <p class="text-sm font-semibold text-slate-950">
                Internship
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Available April 2027 · 6 months
              </p>

            </div>

          </div>

        </aside>

      </div>

    </section>


    <!-- EDUCATION -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
      >
        Education
      </p>

      <div class="mt-12 divide-y divide-slate-200">


        <!-- ECOLE POLYTECHNIQUE -->

        <article
          class="grid gap-6 py-10 first:pt-0 md:grid-cols-[170px_1fr]"
        >

          <p class="text-sm text-slate-400">
            2026–2027
          </p>

          <div>

            <h2
              class="text-xl font-semibold tracking-tight text-slate-950"
            >
              École Polytechnique
            </h2>

            <p class="mt-2 text-slate-600">
              M2 Data Science
            </p>

            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-500">
              Institut Polytechnique de Paris. Graduate studies focused on
              advanced machine learning, data science and modern AI methods.
            </p>

          </div>

        </article>


        <!-- TELECOM -->

        <article
          class="grid gap-6 py-10 md:grid-cols-[170px_1fr]"
        >

          <p class="text-sm text-slate-400">
            2025–2027
          </p>

          <div>

            <h2
              class="text-xl font-semibold tracking-tight text-slate-950"
            >
              Télécom Paris
            </h2>

            <p class="mt-2 text-slate-600">
              Diplôme d'Ingénieur · Double Degree Program
            </p>

            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-500">
              Academic tracks in Signal Processing & Artificial Intelligence
              and Markets, Organizations & Data.
            </p>

          </div>

        </article>


        <!-- UNI -->

        <article
          class="grid gap-6 py-10 md:grid-cols-[170px_1fr]"
        >

          <p class="text-sm text-slate-400">
            2020–2025
          </p>

          <div>

            <h2
              class="text-xl font-semibold tracking-tight text-slate-950"
            >
              Universidad Nacional de Ingeniería
            </h2>

            <p class="mt-2 text-slate-600">
              Electronic Engineering
            </p>

            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-500">
              Engineering background in signals, electronics, programming,
              computer vision, statistics and intelligent systems.
            </p>

          </div>

        </article>

      </div>

    </section>


    <!-- INTERESTS -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>

          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Current Interests
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Areas I want to keep exploring.
          </h2>

        </div>


        <div class="flex flex-wrap gap-3">

          {
            [
              "Machine Learning",
              "Natural Language Processing",
              "LLMs",
              "Graph Machine Learning",
              "Streaming Data",
              "Applied AI",
              "Time Series",
              "Computer Vision",
              "AI Engineering",
              "Data-Driven Systems",
            ].map((interest) => (
              <span
                class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-600"
              >
                {interest}
              </span>
            ))
          }

        </div>

      </div>

    </section>


    <!-- AWARDS -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
      >
        Awards & Scholarships
      </p>

      <h2
        class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-slate-950"
      >
        Academic and international recognition.
      </h2>


      <div class="mt-12 grid gap-6 md:grid-cols-2">

        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2025
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            Eiffel Excellence Scholarship
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            French Government scholarship supporting graduate studies in
            France.
          </p>

        </article>

        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2024
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            Huawei · Seeds for the Future
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            Selected for Huawei's international training program and completed
            technical coursework in artificial intelligence and cloud technologies,
            including HCIA-AI training.
          </p>

        </article>


        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2024
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            University of Alberta Research Experience
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            Research program at the University of Alberta, Canada.
          </p>

        </article>


        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2024
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            SUSI Women Leaders Scholarship
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            Study of the United States Institutes leadership program.
          </p>

        </article>


        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2024
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            PhawAI Artificial Intelligence Research Congress Scholarship
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            Scholarship supporting participation in an AI research congress.
          </p>

        </article>


        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2023
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            Top 8 · GDSC Peru Hack
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            Hackathon organized by Google Developer Student Clubs of Peru.
          </p>

        </article>


        <article
          class="rounded-2xl border border-slate-200 bg-white p-7"
        >

          <p class="text-sm text-slate-400">
            2021–2022
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-950">
            Academic Ranking Recognition
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-600">
            First place in the Faculty of Electrical and Electronic
            Engineering and second place in cumulative weighted GPA.
          </p>

        </article>

      </div>

    </section>


    <!-- LEADERSHIP -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>

          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Leadership
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Building technical communities alongside engineering work.
          </h2>

        </div>


        <div class="divide-y divide-slate-200">

          <article class="pb-8">

            <p class="text-sm text-slate-400">
              2025–2026
            </p>

            <h3 class="mt-2 font-semibold text-slate-950">
              Student Representative · MODS Study Track · Télécom Paris
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Represented students in the Markets, Organizations & Data (MODS) study
              track and participated in semester feedback meetings with the academic
              team.
            </p>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Collected and synthesized feedback from classmates and presented their
              comments, concerns and suggestions during review meetings for both the
              first and second semesters.
            </p>

          </article>

          <article class="pb-8">

            <p class="text-sm text-slate-400">
              2024–2025
            </p>

            <h3 class="mt-2 font-semibold text-slate-950">
              Vice President · Developer Student Club UNI
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Supported the planning and coordination of student-led
              technology initiatives, workshops and community activities.
            </p>

          </article>

          <article class="py-8">

            <p class="text-sm text-slate-400">
              2024
            </p>

            <h3 class="mt-2 font-semibold text-slate-950">
              Logistics Coordinator · IEEE Neurociencia Perú
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Participated in organizing and coordinating key aspects
               of the IV International Neuroscience Congress 2024.
            </p>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Assisted with technical visits at UNTELS and contributed to obtaining 
              a database of prominent speakers in Neuroscience.
            </p>

          </article>


          <article class="py-8">

            <p class="text-sm text-slate-400">
              2023
            </p>

            <h3 class="mt-2 font-semibold text-slate-950">
              President · IEEE Engineering in Medicine and Biology Society
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Led the student chapter, expanded its activities and organized
              international events with IEEE communities across Latin America.
            </p>

          </article>


          <article class="pt-8">

            <p class="text-sm text-slate-400">
              2022
            </p>

            <h3 class="mt-2 font-semibold text-slate-950">
              Treasurer · IEEE Robotics and Automation Society
            </h3>

            <p class="mt-3 text-sm leading-7 text-slate-600">
              Promoted robotics and automation through presentations and workshops.
            </p>
            <p class="mt-3 text-sm leading-7 text-slate-600">
              Contacted speakers on topics of high interest within the IEEE RAS community.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- TALKS -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
      >
        Talks & Conferences
      </p>

      <h2
        class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-slate-950"
      >
        Research communication beyond the classroom.
      </h2>


      <div class="mt-12 divide-y divide-slate-200">

        <article
          class="grid gap-4 py-7 first:pt-0 sm:grid-cols-[110px_1fr]"
        >

          <p class="text-sm text-slate-400">
            Oct 2024
          </p>

          <div>

            <h3 class="font-semibold text-slate-950">
              Young Researchers Panel
            </h3>

            <p class="mt-2 text-sm text-slate-500">
              IV International Congress of Neurosciences
            </p>

          </div>

        </article>


        <article
          class="grid gap-4 py-7 sm:grid-cols-[110px_1fr]"
        >

          <p class="text-sm text-slate-400">
            Jul 2024
          </p>

          <div>

            <h3 class="font-semibold text-slate-950">
              Brain–Machine Interface for Wheelchair Control
            </h3>

            <p class="mt-2 text-sm text-slate-500">
              2nd International Congress of Engineering for Health
            </p>

          </div>

        </article>


        <article
          class="grid gap-4 py-7 sm:grid-cols-[110px_1fr]"
        >

          <p class="text-sm text-slate-400">
            Nov 2023
          </p>

          <div>

            <h3 class="font-semibold text-slate-950">
              Applications and Perspectives of EEG and EMG Signals
            </h3>

            <p class="mt-2 text-sm text-slate-500">
              IEEE Biotechnology and Biomedical Engineering Symposium
            </p>

          </div>

        </article>

      </div>

    </section>


    <!-- LANGUAGES -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div class="grid gap-12 lg:grid-cols-[1fr_2fr]">

        <div>

          <p
            class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
          >
            Languages
          </p>

          <h2
            class="mt-4 text-3xl font-semibold tracking-tight text-slate-950"
          >
            Working across international environments.
          </h2>

        </div>


        <div class="grid gap-8 sm:grid-cols-3">

          <div>

            <p class="font-semibold text-slate-950">
              Spanish
            </p>

            <p class="mt-2 text-sm text-slate-500">
              Native
            </p>

          </div>


          <div>

            <p class="font-semibold text-slate-950">
              English
            </p>

            <p class="mt-2 text-sm text-slate-500">
              Professional working proficiency
            </p>

          </div>


          <div>

            <p class="font-semibold text-slate-950">
              French
            </p>

            <p class="mt-2 text-sm text-slate-500">
              Intermediate
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- FINAL CTA -->

    <section
      class="mx-auto max-w-6xl border-t border-slate-200 px-6 py-24 lg:px-8"
    >

      <div
        class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
      >

        <div class="max-w-2xl">

          <p
            class="text-sm uppercase tracking-[0.18em] text-slate-400"
          >
            Selected Work
          </p>

          <h2
            class="mt-3 text-2xl font-semibold text-slate-950"
          >
            See how this background translates into technical projects.
          </h2>

        </div>


        <a
          href="/projects"
          class="text-sm font-medium text-slate-900"
        >
          View projects →
        </a>

      </div>

    </section>

  </main>

  <Footer />

</BaseLayout>