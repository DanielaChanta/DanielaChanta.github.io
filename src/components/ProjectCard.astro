---
interface Props {
  title: string;
  slug: string;
  category: string;
  year: string;
  description: string;
  technologies: string[];
  hasPage: boolean;
  metric?: string;
}

const {
  title,
  slug,
  category,
  year,
  description,
  technologies,
  hasPage,
  metric,
} = Astro.props;
---

<article
  class="group flex h-full flex-col justify-between rounded-2xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg hover:shadow-slate-200/50"
>

  <div>

    <div class="flex items-center justify-between gap-4">

      <p
        class="text-xs font-medium uppercase tracking-[0.14em] text-slate-500"
      >
        {category}
      </p>

      <span class="text-xs text-slate-400">
        {year}
      </span>

    </div>


    <h3
      class="mt-5 text-xl font-semibold tracking-tight text-slate-950"
    >
      {title}
    </h3>


    <p class="mt-4 leading-7 text-slate-600">
      {description}
    </p>


    {
      metric && (
        <div class="mt-5">
          <p
            class="text-sm font-medium text-slate-800"
          >
            {metric}
          </p>
        </div>
      )
    }


    <div class="mt-6 flex flex-wrap gap-2">

      {
        technologies.map((technology) => (
          <span
            class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600"
          >
            {technology}
          </span>
        ))
      }

    </div>

  </div>


  {
    hasPage && (
      <a
        href={`/projects/${slug}`}
        class="mt-8 inline-flex items-center text-sm font-medium text-slate-900 transition group-hover:translate-x-1"
      >
        View project
        <span class="ml-2">→</span>
      </a>
    )
  }

</article>