---
interface Props {
  category: string;
  title: string;
  description: string;
  year: string;
  role: string;
  organization: string;
  technologies: string[];
}

const {
  category,
  title,
  description,
  year,
  role,
  organization,
  technologies,
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 pb-20 pt-40 lg:px-8">
  <a
    href="/projects"
    class="text-sm text-slate-500 transition hover:text-slate-950"
  >
    ← Back to projects
  </a>

  <div class="mt-12 max-w-4xl">
    <p
      class="text-sm font-medium uppercase tracking-[0.18em] text-slate-500"
    >
      {category}
    </p>

    <h1
      class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl"
    >
      {title}
    </h1>

    <p
      class="mt-7 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl"
    >
      {description}
    </p>
  </div>

  <div
    class="mt-14 grid gap-8 border-t border-slate-200 pt-8 sm:grid-cols-3"
  >
    <div>
      <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
        Role
      </p>

      <p class="mt-2 text-sm font-medium text-slate-900">
        {role}
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
        Organization
      </p>

      <p class="mt-2 text-sm font-medium text-slate-900">
        {organization}
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.15em] text-slate-400">
        Year
      </p>

      <p class="mt-2 text-sm font-medium text-slate-900">
        {year}
      </p>
    </div>
  </div>

  <div class="mt-8 flex flex-wrap gap-2">
    {
      technologies.map((technology) => (
        <span
          class="rounded-full bg-slate-100 px-3 py-1.5 text-xs text-slate-600"
        >
          {technology}
        </span>
      ))
    }
  </div>
</section>